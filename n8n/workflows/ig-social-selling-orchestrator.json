    {
      "parameters": {
        "jsCode": "const response = $input.first()?.json ?? {};\nconst status = Number(response.statusCode ?? 200);\nconst body = response.body ?? response;\nif (status < 200 || status >= 300 || body.ok !== true) {\n  throw new Error(`claim_failed:${status}`);\n}\nif (!body.job) return [];\nconst engagement = body.engagement ?? {\n  organization_id: body.event?.organization_id,\n  instagram_account_id: body.event?.instagram_account_id,\n  webhook_event_id: body.event?.id,\n  external_engagement_id: body.event?.comment_id,\n  engagement_type: 'comment',\n  source: 'realtime',\n  occurred_at: body.event?.received_at,\n};\nreturn [{ json: { claim: body, engagement } }];"
      },
