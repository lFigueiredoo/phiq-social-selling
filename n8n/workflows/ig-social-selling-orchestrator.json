    {
      "parameters": {
        "jsCode": "const response = $input.first()?.json ?? {};\nconst status = Number(response.pipeline_status ?? response.statusCode ?? 200);\nconst rawBody = response.pipeline_response ?? response.body ?? response;\nlet body = rawBody;\nconst streamBytes = rawBody?._readableState?.buffer?.[0]?.data;\nif (Array.isArray(streamBytes)) {\n  try { body = JSON.parse(Buffer.from(streamBytes).toString('utf8')); } catch { body = {}; }\n} else if (typeof rawBody === 'string') {\n  try { body = JSON.parse(rawBody); } catch { body = {}; }\n}\nif (body?.data && body.result_code === undefined) body = body.data;\nconst gate = $('Gate claimed job').first().json;\nconst claim = gate.claim;\nconst completed = new Set(['classified', 'routed', 'no_profile', 'needs_more_signal', 'lead_closed', 'already_processed']);\nlet action = 'fail';\nlet error = body?.error_code ?? body?.error ?? `pipeline_http_${status}`;\nif (status >= 200 && status < 300 && completed.has(body?.result_code)) {\n  action = 'complete';\n  error = '';\n} else if (status === 400 || body?.result_code === 'terminal_error') {\n  action = 'dead_letter';\n  error = `terminal:${body?.error_code ?? body?.error ?? 'invalid_pipeline_input'}`;\n}\nconst attempts = Number(claim.job.attempts ?? 1);\nconst retryAfterSeconds = Math.min(900, 30 * (2 ** Math.max(0, attempts - 1)));\nconst draftEligible = action === 'complete'\n  && gate.engagement?.engagement_type === 'comment'\n  && body?.result_code !== 'lead_closed';\nreturn [{ json: {\n  action,\n  job_id: claim.job.id,\n  worker_id: claim.job.locked_by,\n  error: String(error).slice(0, 500),\n  retry_after_seconds: retryAfterSeconds,\n  result_code: body?.result_code ?? null,\n  draft_eligible: draftEligible,\n} }];"
