# Copie este arquivo para .env e preencha com valores reais.
# NUNCA faça commit do arquivo .env preenchido.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / Instagram ---
# Integração: Instagram API with Instagram Login (host: graph.instagram.com).
# Ver docs/meta-setup.md.
#
# META_INSTAGRAM_APP_ID só é necessária se o dashboard apresentar um ID
# do Instagram separado do App ID principal. Se houver apenas um ID
# aplicável ao nosso fluxo, remova esta variável em vez de duplicar.
#
# META_API_VERSION deve ser lida do App Dashboard, não fixada por memória.
META_APP_ID=
META_INSTAGRAM_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_API_VERSION=

# --- OpenAI ---
OPENAI_API_KEY=

# --- n8n ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Google Sheets ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
