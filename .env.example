# Copie este arquivo para .env e preencha com valores reais.
# NUNCA faça commit do arquivo .env preenchido.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta / Instagram ---
# Modo ativo por padrão: Instagram API with Instagram Login
# (host: graph.instagram.com). A migração para Unified Login é canário e
# usa credenciais separadas; nunca reutilize ou sobrescreva o token legado.
# Ver docs/meta-setup.md.
META_AUTH_MODE=instagram_login
#
# META_INSTAGRAM_APP_ID só é necessária se o dashboard apresentar um ID
# do Instagram separado do App ID principal. Se houver apenas um ID
# aplicável ao nosso fluxo, remova esta variável em vez de duplicar.
#
# META_API_VERSION deve ser lida do App Dashboard, não fixada por memória.
META_APP_ID=
META_INSTAGRAM_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_API_VERSION=
# Candidato Unified Login (host: graph.facebook.com). Deixe vazio enquanto o
# canário não estiver configurado. Nunca altere META_AUTH_MODE antes de cadastrar
# os aliases de api_user_id/webhook_entry_id e validar leitura + webhook.
META_UNIFIED_ACCESS_TOKEN=
META_UNIFIED_API_VERSION=
META_UNIFIED_APP_SECRET=
META_UNIFIED_VERIFY_TOKEN=
# Trava fail-safe: somente o valor explícito false permite envio à Meta.
INSTAGRAM_DISPATCH_DRY_RUN=true
# Escopo fail-safe do piloto: somente o valor explícito false permite Direct.
# Mantenha true enquanto o piloto autorizar apenas respostas públicas aprovadas.
INSTAGRAM_DISPATCH_PUBLIC_REPLY_ONLY=true

# --- n8n ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Segredo compartilhado para as Edge Functions backend-only (inclui classify-social-lead).
N8N_WORKER_SECRET=
# O Gemini usa a credencial criptografada `Google Gemini(PaLM) Api account`
# no n8n. A chave do provider não pertence a este arquivo nem ao Supabase.

# --- Google Sheets ---
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Painel de aprovação (panel-*) ---
# Lida por supabase/functions/_shared/cors.ts. Allowlist exata de origens
# (scheme+host+porta), separadas por vírgula, sem wildcard. Enquanto vazia,
# nenhuma chamada de navegador às Edge Functions panel-* é aceita (CORS).
# Configurar em produção é uma decisão separada, feita deliberadamente.
# Para rodar o frontend local (panel-web/), defina esta variável só no
# arquivo de ambiente local usado por `supabase functions serve`, nunca
# aqui/em produção.
PANEL_ALLOWED_ORIGINS=
